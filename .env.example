# Portal database (its own database; on the dev box it shares the Supabase Postgres:
#   docker exec supabase_db_react psql -U postgres -c 'create database qubo_portal')
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:54322/qubo_portal"

# Better Auth. BETTER_AUTH_URL = the portal app's public URL (auth is proxied same-origin).
BETTER_AUTH_SECRET="change-me-32+chars"
BETTER_AUTH_URL="https://portal.qubo.by-ali.dev"
TRUSTED_ORIGINS="https://portal.qubo.by-ali.dev"

# Public URLs (qd sets these in dev; set them explicitly in prod).
PORTAL_URL="https://portal.qubo.by-ali.dev"
PORTAL_API_URL="https://api.portal.qubo.by-ali.dev"
NEXT_PUBLIC_PORTAL_URL="https://portal.qubo.by-ali.dev"
SITE_URL="https://qubo.by-ali.dev"
# Server-to-server URL of the API from the portal/marketing containers.
PORTAL_API_INTERNAL_URL="http://api:3340"

# Ed25519 licence signing keys, required in production: pnpm keys:generate
# Dev generates one into .qubo/signing-keys.json automatically.
# PORTAL_SIGNING_KEYS='[{"kty":"OKP","crv":"Ed25519",...}]'

# Stripe Billing (Phase 5)
# STRIPE_SECRET_KEY=""
# STRIPE_WEBHOOK_SECRET=""
