{
  "$comment": "Dev runner config for scripts/dev/qd. The portal has its own slots (devDigit 5 \u2192 5010/5020/5030) and hosts under qubo.dev.by-ali.dev, so it runs alongside qubo-stack (devDigit 4, dev.by-ali.dev). Edge routes: ~/infra/edge/dynamic/qubo-dev.yml. Per-machine overrides: .qubo/dev.local.json (gitignored).",
  "project": "qubo-portal",
  "session": "qubo-portal",
  "devDigit": 5,
  "sitesBaseDomain": "qubo.dev.by-ali.dev",
  "services": {
    "api": {
      "cwd": "packages/api",
      "cmd": [
        "bun",
        "--watch",
        "src/server.ts"
      ],
      "portSlot": 3,
      "health": "/health",
      "host": "api.qubo.dev.by-ali.dev",
      "env": {
        "PORTAL_URL": "{url:portal}",
        "PORTAL_API_URL": "{url:api}",
        "BETTER_AUTH_URL": "{url:portal}",
        "TRUSTED_ORIGINS": "{url:portal}"
      }
    },
    "portal": {
      "cwd": "apps/portal",
      "cmd": [
        "pnpm",
        "exec",
        "next",
        "dev",
        "--port",
        "{port}",
        "--hostname",
        "{bind}"
      ],
      "portSlot": 1,
      "health": "/login",
      "host": "portal.qubo.dev.by-ali.dev",
      "env": {
        "PORTAL_API_INTERNAL_URL": "{internal:api}",
        "BETTER_AUTH_URL": "{url:portal}",
        "PORTAL_API_URL": "{url:api}"
      }
    },
    "marketing": {
      "cwd": "apps/marketing",
      "cmd": [
        "pnpm",
        "exec",
        "next",
        "dev",
        "--port",
        "{port}",
        "--hostname",
        "{bind}"
      ],
      "portSlot": 2,
      "health": "/",
      "host": "qubo.dev.by-ali.dev",
      "env": {
        "PORTAL_URL": "{url:portal}",
        "SITE_URL": "{url:marketing}",
        "PORTAL_API_INTERNAL_URL": "{internal:api}"
      }
    }
  },
  "order": [
    "api",
    "portal",
    "marketing"
  ],
  "dataPlane": {
    "containers": [
      "supabase_db_react"
    ],
    "databaseUrlEnv": "DATABASE_URL",
    "localHint": "Start Docker, then `supabase start`. The portal uses its own database (qubo_portal) on the same Postgres."
  }
}
